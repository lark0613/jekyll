# Gemfile
source "https://rubygems.org"

# Jekyll 核心
gem "jekyll", "~> 4.4"

# GitHub Pages 支持的插件（必须写在这里）
gem "jekyll-feed"
gem "jekyll-seo-tag"
gem "webrick"           # Ruby 3.0+ 必须加这个

# 可选：让本地构建更快
gem "wdm", "~> 0.1.0" if Gem.win_platform?

